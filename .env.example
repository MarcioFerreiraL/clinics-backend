# Modelo das variáveis de ambiente do back-end. Copie para `.env` e ajuste.
# O `.env` NUNCA vai para o Git (está no .gitignore). Aqui só ficam valores de exemplo.

# --- Banco de dados (PostgreSQL) ---
DB_URL=jdbc:postgresql://localhost:5433/clinics
DB_USER=clinics
DB_PASSWORD=troque-esta-senha

# --- Segurança (JWT, HS256) ---
# Mínimo de 32 caracteres. Gere um valor aleatório: openssl rand -hex 32
JWT_SECRET=troque-por-uma-chave-aleatoria-com-pelo-menos-32-caracteres

# --- Aplicação ---
PORT=8080
AVATARS_DIR=./data/avatars

# --- Só para o compose de produção ---
# Porta publicada em 127.0.0.1 da VPS (o acesso externo é pelo Cloudflare Tunnel)
API_PORT=8080
